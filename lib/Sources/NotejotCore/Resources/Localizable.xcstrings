{
  "sourceLanguage": "en",
  "strings": {
    "Start writing your notes here. Use New Note to create a note, the tag button to organize it, and All Notes or Trash in Destinations.": {
      "comment": "Body of the welcome note created for a new user.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a scrivere qui le tue note. Usa Nuova nota per creare una nota, il pulsante dei tag per organizzarla e Tutte le note o Cestino in Destinazioni."
          }
        }
      }
    },
    "Start writing your notes here.": {
      "comment": "Body of the welcome note created for a new user.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a scrivere qui le tue note."
          }
        }
      }
    },
    "The notes file could not be read and was preserved as %@.": {
      "comment": "Error shown after preserving an unreadable notes file; the variable is its backup filename.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file delle note; è stato conservato come %@."
          }
        }
      }
    },
    "The notes file could not be read or preserved: %@": {
      "comment": "Error shown when an unreadable notes file also could not be preserved; the variable is the system error.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere o conservare il file delle note: %@"
          }
        }
      }
    },
    "Welcome to Notejot": {
      "comment": "Title of the welcome note created for a new user.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto in Notejot"
          }
        }
      }
    }
  },
  "version": "1.0"
}
