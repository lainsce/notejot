    },
    "Notejot is a local-first notes app. It does not collect, sell, or share your personal data. Voice recognition may use Apple Speech Recognition for live partial text, as described below." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notejot è un'app di note locale. Non raccoglie, vende né condivide i tuoi dati personali. Il riconoscimento vocale può usare il riconoscimento vocale di Apple per il testo parziale in tempo reale, come descritto di seguito."
          }
        }
      }
    },
    "Notes" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note"
          }
        }
      }
    },
    "Notes, tags, and attached images stay in this app’s local storage on your device. Notejot has no accounts, analytics, advertising, or tracking, and does not collect personal data." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, tag e immagini allegate restano nella memoria locale dell'app sul tuo dispositivo. Notejot non utilizza account, analisi, pubblicità o tracciamento e non raccoglie dati personali."
          }
        }
      }
    },
