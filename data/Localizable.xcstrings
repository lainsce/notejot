    "Notejot is a local-first notes app. It does not collect, transmit, sell, or share your personal data." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notejot è un'app di note locale. Non raccoglie, trasmette, vende né condivide i tuoi dati personali."
          }
        }
      }
    },
    "Notes" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note"
          }
        }
      }
    },
    "Notes, tags, and attached images stay in this app’s local storage on your device. Notejot has no accounts, analytics, advertising, tracking, or third-party SDKs." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, tag e immagini allegate restano nella memoria locale dell'app sul tuo dispositivo. Notejot non utilizza account, analisi, pubblicità, tracciamento né SDK di terze parti."
          }
        }
      }
    },
